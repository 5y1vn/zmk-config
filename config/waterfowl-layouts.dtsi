/ {
    default_transform: default_transform {
        compatible = "zmk,physical-layout";
        display-name = "default transform";

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   38       0     0     0>
            , <&key_physical_attrs 100 100  100   13       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300   13       0     0     0>
            , <&key_physical_attrs 100 100  400   25       0     0     0>
            , <&key_physical_attrs 100 100  800   25       0     0     0>
            , <&key_physical_attrs 100 100  900   13       0     0     0>
            , <&key_physical_attrs 100 100 1000    0       0     0     0>
            , <&key_physical_attrs 100 100 1100   13       0     0     0>
            , <&key_physical_attrs 100 100 1200   38       0     0     0>
            , <&key_physical_attrs 100 100    0  138       0     0     0>
            , <&key_physical_attrs 100 100  100  113       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  113       0     0     0>
            , <&key_physical_attrs 100 100  400  125       0     0     0>
            , <&key_physical_attrs 100 100  800  125       0     0     0>
            , <&key_physical_attrs 100 100  900  113       0     0     0>
            , <&key_physical_attrs 100 100 1000  100       0     0     0>
            , <&key_physical_attrs 100 100 1100  113       0     0     0>
            , <&key_physical_attrs 100 100 1200  138       0     0     0>
            , <&key_physical_attrs 100 100    0  238       0     0     0>
            , <&key_physical_attrs 100 100  100  213       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  213       0     0     0>
            , <&key_physical_attrs 100 100  400  225       0     0     0>
            , <&key_physical_attrs 100 100  800  225       0     0     0>
            , <&key_physical_attrs 100 100  900  213       0     0     0>
            , <&key_physical_attrs 100 100 1000  200       0     0     0>
            , <&key_physical_attrs 100 100 1100  213       0     0     0>
            , <&key_physical_attrs 100 100 1200  238       0     0     0>
            , <&key_physical_attrs 100 100  200  315       0     0     0>
            , <&key_physical_attrs 100 100  248  315    1500   298   765>
            , <&key_physical_attrs 100 100  525  160       0     0     0>
            , <&key_physical_attrs 100 100  670  160       0     0     0>
            , <&key_physical_attrs 100 100  248  315    3000   298   765>
            , <&key_physical_attrs 100 100  248  315    4500   298   765>
            , <&key_physical_attrs 100 100  952  315 (-4500)  1002   765>
            , <&key_physical_attrs 100 100  952  315 (-3000)  1002   765>
            , <&key_physical_attrs 100 100  952  315 (-1500)  1002   765>
            , <&key_physical_attrs 100 100 1000  315       0     0     0>
            ;
    };

    position_map {
        compatible = "zmk,physical-layout-position-map";

        default_transform {
            physical-layout = <&default_transform>;
            positions = <>;
        };
    };
};
